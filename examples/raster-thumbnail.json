{
  "path_pattern": "(?P<scene>[^/]+)/(?P<asset>raster|thumbnail)\\.(?P<extension>tif|png)",
  "item_id_template": "{scene}",
  "asset_key_template": "{asset}",
  "datetime_template": "2026-01-01T00:00:00Z",
  "reference_asset": "raster",
  "required_assets": ["raster", "thumbnail"],
  "non_raster_assets": {
    ".png": {"media_type": "image/png", "roles": ["thumbnail"]}
  }
}
